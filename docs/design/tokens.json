{
  "$schema": "nectarlink-design-tokens/v1",
  "$description": "Single source of truth for NectarLink WinUI 3 design tokens (Mica and Acrylic).",
  "themes": {
    "mica": {
      "description": "Windows 11 Mica material theme: wallpaper-sampled compositor backdrop with airy translucent navigation rail and layered elevation cards tinted with Windows accent.",
      "dynamicColor": false,
      "variants": {
        "light": {
          "primary": "#0067C0",
          "onPrimary": "#FFFFFF",
          "primaryContainer": "#E3F0FC",
          "onPrimaryContainer": "#003E75",
          "secondaryContainer": "#E9ECEF",
          "onSecondaryContainer": "#1A1C1E",
          "surface": "#F3F5F8",
          "surfaceContainerLow": "#EEF1F5",
          "surfaceContainer": "#FFFFFF",
          "surfaceContainerHigh": "#F8FAFC",
          "surfaceContainerHighest": "#EDF0F4",
          "onSurface": "#191C1F",
          "onSurfaceVariant": "#5A5F66",
          "outline": "#838991",
          "outlineVariant": "#DDE1E6",
          "success": "#0F7B0F",
          "warning": "#945700",
          "error": "#C42B1C",
          "onError": "#FFFFFF"
        },
        "dark": {
          "primary": "#60CDFF",
          "onPrimary": "#002B40",
          "primaryContainer": "#1B3A4B",
          "onPrimaryContainer": "#CFEBFF",
          "secondaryContainer": "#2E3236",
          "onSecondaryContainer": "#F0F4F8",
          "surface": "#1F2124",
          "surfaceContainerLow": "#1C1E21",
          "surfaceContainer": "#2B2E32",
          "surfaceContainerHigh": "#34373C",
          "surfaceContainerHighest": "#3D4147",
          "onSurface": "#F5F7FA",
          "onSurfaceVariant": "#C1C6CE",
          "outline": "#8F959E",
          "outlineVariant": "#3B3E44",
          "success": "#6CCB5F",
          "warning": "#FCE100",
          "error": "#FF99A4",
          "onError": "#260004"
        }
      },
      "status": {
        "light": {
          "success": "#0F7B0F",
          "warning": "#945700",
          "error": "#C42B1C",
          "onError": "#FFFFFF"
        },
        "dark": {
          "success": "#6CCB5F",
          "warning": "#FCE100",
          "error": "#FF99A4",
          "onError": "#260004"
        }
      },
      "shape": {
        "xs": 4,
        "sm": 6,
        "md": 8,
        "lg": 10,
        "xl": 14,
        "full": 999
      },
      "fonts": {
        "ui": "Segoe UI Variable Text",
        "display": "Segoe UI Variable Display",
        "label": "Segoe UI Variable Text",
        "mono": "Cascadia Mono"
      },
      "label": {
        "case": "none",
        "tracking": 0,
        "size": 13.5,
        "weight": 600
      },
      "rules": [
        "Mica Base compositor backdrop behind a transparent window canvas.",
        "Navigation rail sits over Mica with a subtle translucent tint; cards use layered fill transparency with crisp 1 px hairline borders."
      ]
    },
    "acrylic": {
      "description": "Frosted translucent Windows Desktop Acrylic material theme with soft luminosity blur, crisp specular hairline borders, and depth across surfaces.",
      "dynamicColor": false,
      "variants": {
        "light": {
          "primary": "#0F6CBD",
          "onPrimary": "#FFFFFF",
          "primaryContainer": "#DCEBFA",
          "onPrimaryContainer": "#003566",
          "secondaryContainer": "#E6ECF2",
          "onSecondaryContainer": "#181C20",
          "surface": "#F4F7FA",
          "surfaceContainerLow": "#ECF1F6",
          "surfaceContainer": "#F9FBFD",
          "surfaceContainerHigh": "#FFFFFF",
          "surfaceContainerHighest": "#E8EEF4",
          "onSurface": "#161A1E",
          "onSurfaceVariant": "#525962",
          "outline": "#7E8691",
          "outlineVariant": "#D3DBE4",
          "success": "#0F7B0F",
          "warning": "#945700",
          "error": "#C42B1C",
          "onError": "#FFFFFF"
        },
        "dark": {
          "primary": "#70D6FF",
          "onPrimary": "#002B3D",
          "primaryContainer": "#1D4053",
          "onPrimaryContainer": "#D4F2FF",
          "secondaryContainer": "#293038",
          "onSecondaryContainer": "#EFF4FA",
          "surface": "#181C20",
          "surfaceContainerLow": "#14181C",
          "surfaceContainer": "#22272D",
          "surfaceContainerHigh": "#2B3138",
          "surfaceContainerHighest": "#343B44",
          "onSurface": "#F2F6FA",
          "onSurfaceVariant": "#BCC4CE",
          "outline": "#8A929D",
          "outlineVariant": "#3B424B",
          "success": "#6CCB5F",
          "warning": "#FCE100",
          "error": "#FF99A4",
          "onError": "#260004"
        }
      },
      "status": {
        "light": {
          "success": "#0F7B0F",
          "warning": "#945700",
          "error": "#C42B1C",
          "onError": "#FFFFFF"
        },
        "dark": {
          "success": "#6CCB5F",
          "warning": "#FCE100",
          "error": "#FF99A4",
          "onError": "#260004"
        }
      },
      "shape": {
        "xs": 4,
        "sm": 6,
        "md": 8,
        "lg": 12,
        "xl": 16,
        "full": 999
      },
      "fonts": {
        "ui": "Segoe UI Variable Text",
        "display": "Segoe UI Variable Display",
        "label": "Segoe UI Variable Text",
        "mono": "Cascadia Mono"
      },
      "label": {
        "case": "none",
        "tracking": 0,
        "size": 13.5,
        "weight": 600
      },
      "rules": [
        "DesktopAcrylicBackdrop behind the window with frosted translucent panels and crisp outlineVariant edges."
      ]
    }
  },
  "typography": {
    "displayLarge": {
      "size": 44,
      "lineHeight": 1.05,
      "weight": 650,
      "tracking": -0.025
    },
    "displaySmall": {
      "size": 30,
      "lineHeight": 1.1,
      "weight": 650,
      "tracking": -0.02
    },
    "headline": {
      "size": 22,
      "lineHeight": 1.2,
      "weight": 650,
      "tracking": -0.015
    },
    "title": {
      "size": 16,
      "lineHeight": 1.35,
      "weight": 600,
      "tracking": 0
    },
    "body": {
      "size": 14,
      "lineHeight": 1.5,
      "weight": 400,
      "tracking": 0
    },
    "bodySmall": {
      "size": 12.5,
      "lineHeight": 1.45,
      "weight": 400,
      "tracking": 0
    },
    "label": {
      "size": 12.5,
      "lineHeight": 1.3,
      "weight": 600,
      "tracking": 0
    },
    "caption": {
      "size": 11,
      "lineHeight": 1.3,
      "weight": 500,
      "tracking": 0
    },
    "code": {
      "size": 13,
      "lineHeight": 1.3,
      "weight": 700,
      "tracking": 0.14,
      "font": "mono"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      0,
      2,
      4,
      6,
      8,
      10,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ]
  },
  "layout": {
    "desktop": {
      "railWidth": 80,
      "topBarHeight": 52,
      "contentPadding": 22,
      "gutter": 16,
      "minWindow": [
        880,
        600
      ]
    },
    "phone": {
      "screenPadding": 16,
      "gutter": 10,
      "tabBarHeight": 64
    }
  },
  "elevation": {
    "bloom": {
      "level0": "none",
      "level1": "0 1px 2px rgba(0,0,0,.06)",
      "window": "0 1px 2px rgba(0,0,0,.06), 0 24px 60px -20px rgba(0,0,0,.18)"
    },
    "graphite": {
      "level0": "none",
      "level1": "none",
      "window": "0 30px 70px -30px rgba(0,0,0,.35)"
    }
  },
  "motion": {
    "description": "Springs everywhere; durations are only for fades. Respect reduced-motion: replace movement with 120 ms fades.",
    "spring": {
      "gentle": {
        "stiffness": 220,
        "damping": 26,
        "use": "page and panel transitions"
      },
      "standard": {
        "stiffness": 380,
        "damping": 30,
        "use": "cards, sheets, expanding a notification into a conversation"
      },
      "snappy": {
        "stiffness": 620,
        "damping": 34,
        "use": "toggles, chips, buttons, hover lift"
      }
    },
    "fade": {
      "fast": 120,
      "normal": 200
    },
    "hoverLift": 2,
    "pressScale": 0.97
  },
  "icons": {
    "set": "Material Symbols Rounded (Apache-2.0)",
    "size": 20,
    "stroke": "outlined, 400 weight; filled when selected"
  }
}
