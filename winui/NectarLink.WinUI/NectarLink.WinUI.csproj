<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NectarLink.WinUI</RootNamespace>
    <AssemblyName>NectarLink.WinUI</AssemblyName>
    <ApplicationIcon>Assets\nectarlink.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <DisableXbfLineInfo>false</DisableXbfLineInfo>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\nectarlink.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\brand\icon-512.png" Link="Assets\brand\icon-512.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\brand\icon.svg" Link="Assets\brand\icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\Figtree.ttf" Link="Assets\fonts\Figtree.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\InstrumentSerif-Regular.ttf" Link="Assets\fonts\InstrumentSerif-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\SpaceMono-Regular.ttf" Link="Assets\fonts\SpaceMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\SpaceMono-Bold.ttf" Link="Assets\fonts\SpaceMono-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\target\$(Configuration)\nectarlink_winui_core.dll" Link="nectarlink_winui_core.dll" Condition="Exists('..\..\target\$(Configuration)\nectarlink_winui_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\debug\nectarlink_winui_core.dll" Link="nectarlink_winui_core.dll" Condition="!Exists('..\..\target\$(Configuration)\nectarlink_winui_core.dll') And Exists('..\..\target\debug\nectarlink_winui_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\$(Configuration)\nectarlink_vcam.dll" Link="nectarlink_vcam.dll" Condition="Exists('..\..\target\$(Configuration)\nectarlink_vcam.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\debug\nectarlink_vcam.dll" Link="nectarlink_vcam.dll" Condition="!Exists('..\..\target\$(Configuration)\nectarlink_vcam.dll') And Exists('..\..\target\debug\nectarlink_vcam.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\$(Configuration)\nectarlink_credprov.dll" Link="nectarlink_credprov.dll" Condition="Exists('..\..\target\$(Configuration)\nectarlink_credprov.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\target\debug\nectarlink_credprov.dll" Link="nectarlink_credprov.dll" Condition="!Exists('..\..\target\$(Configuration)\nectarlink_credprov.dll') And Exists('..\..\target\debug\nectarlink_credprov.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
